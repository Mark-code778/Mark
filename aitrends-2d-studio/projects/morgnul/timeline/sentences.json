[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.72,
  "text": "Ты моргаешь, и тебе уже двадцать два."
 },
 {
  "i": 1,
  "start": 3.14,
  "end": 6.66,
  "text": "Моргаешь еще раз, и твой лучший друг Егор женат."
 },
 {
  "i": 2,
  "start": 7.02,
  "end": 11.52,
  "text": "Моргаешь в третий раз, и у Егора появляется сын, которого зовут Максим."
 },
 {
  "i": 3,
  "start": 11.98,
  "end": 19.12,
  "text": "Моргаешь в четвертый раз, ты стоишь посреди автосалона на Кутузовском проспекте, не моргая четвертую минуту."
 },
 {
  "i": 4,
  "start": 19.36,
  "end": 21.58,
  "text": "Сергей Николаевич протягивает конверт."
 },
 {
  "i": 5,
  "start": 21.96,
  "end": 23.52,
  "text": "Максим, твоя премия."
 },
 {
  "i": 6,
  "start": 23.96,
  "end": 26.1,
  "text": "А Егор вытирает тебе слезы."
 },
 {
  "i": 7,
  "start": 26.48,
  "end": 28.04,
  "text": "А теперь давай сначала."
 },
 {
  "i": 8,
  "start": 28.04,
  "end": 29.78,
  "text": "Тебя зовут Максим."
 },
 {
  "i": 9,
  "start": 29.96,
  "end": 31.4,
  "text": "Тебе двадцать один год."
 },
 {
  "i": 10,
  "start": 31.74,
  "end": 35.02,
  "text": "Ты живешь в Москве и работаешь менеджером в автосалоне."
 },
 {
  "i": 11,
  "start": 35.36,
  "end": 40.4,
  "text": "Твой начальник, Сергей Николаевич, обещает выписать тебе премию уже больше месяца."
 },
 {
  "i": 12,
  "start": 40.7,
  "end": 48.02,
  "text": "У тебя есть лучший друг Егор, который знает о тебе все, даже то, что ты до сих пор не любишь темные подъезды."
 },
 {
  "i": 13,
  "start": 48.06,
  "end": 51.5,
  "text": "И все это начинается в самый обычный понедельник."
 },
 {
  "i": 14,
  "start": 51.84,
  "end": 57.58,
  "text": "Ты стоишь в салоне возле серого кроссовера за три миллиона восемьсот девяносто девять тысяч рублей."
 },
 {
  "i": 15,
  "start": 57.94,
  "end": 58.82,
  "text": "Клиентов нет."
 },
 {
  "i": 16,
  "start": 59.1,
  "end": 61.04,
  "text": "Кофе остыл еще в девять утра."
 },
 {
  "i": 17,
  "start": 61.42,
  "end": 68.28,
  "text": "Мимо проходит Сергей Николаевич, хлопает тебя по плечу и говорит Максим, премия на этой неделе."
 },
 {
  "i": 18,
  "start": 68.42,
  "end": 68.84,
  "text": "Точно."
 },
 {
  "i": 19,
  "start": 69.28,
  "end": 72.84,
  "text": "Ты слышишь эту фразу уже тридцать четвертый день подряд."
 },
 {
  "i": 20,
  "start": 73.12,
  "end": 75.22,
  "text": "До конца смены – восемь часов."
 },
 {
  "i": 21,
  "start": 75.5,
  "end": 79.52,
  "text": "Ты смотришь на часы над кассой, и в голове крутится одна мысль."
 },
 {
  "i": 22,
  "start": 79.84,
  "end": 81.84,
  "text": "Скорее бы все это закончилось."
 },
 {
  "i": 23,
  "start": 82.22,
  "end": 83.64,
  "text": "И ты моргаешь."
 },
 {
  "i": 24,
  "start": 83.64,
  "end": 85.2,
  "text": "Ты открываешь глаза."
 },
 {
  "i": 25,
  "start": 85.66,
  "end": 88.88,
  "text": "Часы над кассой показывают ту же самую минуту."
 },
 {
  "i": 26,
  "start": 89.0,
  "end": 90.88,
  "text": "Но кроссовер почему -то красный."
 },
 {
  "i": 27,
  "start": 91.04,
  "end": 96.38,
  "text": "На ценнике четыре миллиона двести тысяч, а на стене висит новый календарь."
 },
 {
  "i": 28,
  "start": 96.52,
  "end": 97.68,
  "text": "Ты достаешь телефон."
 },
 {
  "i": 29,
  "start": 98.12,
  "end": 100.9,
  "text": "Год на экране на один больше, чем должен быть."
 },
 {
  "i": 30,
  "start": 101.32,
  "end": 107.1,
  "text": "Мимо снова проходит Сергей Николаевич и говорит Максим, премия на этой неделе."
 },
 {
  "i": 31,
  "start": 107.2,
  "end": 107.64,
  "text": "Точно."
 },
 {
  "i": 32,
  "start": 108.08,
  "end": 109.14,
  "text": "Ты не выдерживаешь."
 },
 {
  "i": 33,
  "start": 109.46,
  "end": 111.38,
  "text": "Вы мне это говорили год назад."
 },
 {
  "i": 34,
  "start": 111.38,
  "end": 113.44,
  "text": "Он даже не останавливается."
 },
 {
  "i": 35,
  "start": 113.76,
  "end": 115.46,
  "text": "Тогда квартал был другой."
 },
 {
  "i": 36,
  "start": 115.98,
  "end": 119.34,
  "text": "В галереи у тебя 342 новые фотографии."
 },
 {
  "i": 37,
  "start": 119.62,
  "end": 121.3,
  "text": "Ты на всех улыбаешься."
 },
 {
  "i": 38,
  "start": 121.46,
  "end": 124.3,
  "text": "В кафе, на набережной, у какого -то моря."
 },
 {
  "i": 39,
  "start": 124.42,
  "end": 125.76,
  "text": "Ты не помнишь ни одной."
 },
 {
  "i": 40,
  "start": 126.16,
  "end": 131.28,
  "text": "Кто -то прожил этот год вместо тебя, и ему, судя по снимкам, было весело."
 },
 {
  "i": 41,
  "start": 131.52,
  "end": 132.28,
  "text": "Это правда."
 },
 {
  "i": 42,
  "start": 132.62,
  "end": 134.18,
  "text": "И это не твоя вина."
 },
 {
  "i": 43,
  "start": 134.74,
  "end": 138.32,
  "text": "Человек моргает от 15 до 20 раз в минуту."
 },
 {
  "i": 44,
  "start": 138.32,
  "end": 143.4,
  "text": "И примерно 10 % времени, пока ты бодрствуешь, глаза у тебя закрыты."
 },
 {
  "i": 45,
  "start": 143.8,
  "end": 148.86,
  "text": "Мозг просто вырезает эти секунды из картинки, поэтому мир для тебя не мигает."
 },
 {
  "i": 46,
  "start": 149.24,
  "end": 155.5,
  "text": "Но если бы у тебя каждое моргание стоило год, за одну минуту ты бы состарился лет на 15."
 },
 {
  "i": 47,
  "start": 155.9,
  "end": 159.22,
  "text": "К обеду тебе было бы больше, чем Сергею Николаевичу."
 },
 {
  "i": 48,
  "start": 159.52,
  "end": 161.22,
  "text": "Тебе повезло только в одном."
 },
 {
  "i": 49,
  "start": 161.58,
  "end": 164.7,
  "text": "Ты еще не знаешь, что работает это не всегда."
 },
 {
  "i": 50,
  "start": 165.22,
  "end": 166.9,
  "text": "В обед ты бежишь к Егору."
 },
 {
  "i": 51,
  "start": 166.9,
  "end": 168.64,
  "text": "Кофейня напротив салона."
 },
 {
  "i": 52,
  "start": 168.76,
  "end": 170.94,
  "text": "Капучина за 350 рублей."
 },
 {
  "i": 53,
  "start": 171.08,
  "end": 175.26,
  "text": "Ты рассказываешь все, он слушает, жует круассан и говорит."
 },
 {
  "i": 54,
  "start": 175.6,
  "end": 179.8,
  "text": "Ты неделю ходишь странной, но чтобы год пропал, это новое."
 },
 {
  "i": 55,
  "start": 180.12,
  "end": 180.92,
  "text": "Ты просишь."
 },
 {
  "i": 56,
  "start": 181.12,
  "end": 183.32,
  "text": "Скажи что -нибудь, что я мог пропустить."
 },
 {
  "i": 57,
  "start": 183.72,
  "end": 185.0,
  "text": "Он пожимает плечами."
 },
 {
  "i": 58,
  "start": 185.4,
  "end": 187.08,
  "text": "Ничего, все как обычно."
 },
 {
  "i": 59,
  "start": 187.4,
  "end": 188.54,
  "text": "И тут он говорит."
 },
 {
  "i": 60,
  "start": 188.92,
  "end": 190.38,
  "text": "Слушай, давай проверим."
 },
 {
  "i": 61,
  "start": 190.7,
  "end": 191.16,
  "text": "Моргни."
 },
 {
  "i": 62,
  "start": 191.5,
  "end": 192.34,
  "text": "Ты моргаешь."
 },
 {
  "i": 63,
  "start": 192.78,
  "end": 196.68,
  "text": "Егор сидит напротив, но у него борода и на пальце кольцо."
 },
 {
  "i": 64,
  "start": 196.92,
  "end": 199.74,
  "text": "Ты на моей свадьбе был дурак, говорит он."
 },
 {
  "i": 65,
  "start": 199.98,
  "end": 201.26,
  "text": "Даже речь произнес."
 },
 {
  "i": 66,
  "start": 201.5,
  "end": 202.64,
  "text": "Ты правда не помнишь?"
 },
 {
  "i": 67,
  "start": 202.92,
  "end": 203.86,
  "text": "И что я сказал?"
 },
 {
  "i": 68,
  "start": 204.18,
  "end": 206.2,
  "text": "Что надо ловить момент."
 },
 {
  "i": 69,
  "start": 206.62,
  "end": 208.46,
  "text": "Ты смотришь в чашку с капучина."
 },
 {
  "i": 70,
  "start": 208.76,
  "end": 215.12,
  "text": "Тебе 23 и тебя больше всего бесит, что тот, другой Максим говорил хорошие речи."
 },
 {
  "i": 71,
  "start": 215.44,
  "end": 219.06,
  "text": "Егор молчит секунд 10, потом очень серьезно говорит."
 },
 {
  "i": 72,
  "start": 219.58,
  "end": 221.14,
  "text": "Больше не моргай."
 },
 {
  "i": 73,
  "start": 221.46,
  "end": 222.04,
  "text": "Вообще."
 },
 {
  "i": 74,
  "start": 222.56,
  "end": 223.56,
  "text": "Но ты не можешь."
 },
 {
  "i": 75,
  "start": 224.0,
  "end": 225.7,
  "text": "Через час ты вдруг чихаешь."
 },
 {
  "i": 76,
  "start": 225.7,
  "end": 228.92,
  "text": "Глаза закрываются сами и ты думаешь с чувством."
 },
 {
  "i": 77,
  "start": 229.1,
  "end": 230.58,
  "text": "Скорее бы выходные."
 },
 {
  "i": 78,
  "start": 230.92,
  "end": 232.06,
  "text": "И открываешь их."
 },
 {
  "i": 79,
  "start": 232.46,
  "end": 234.0,
  "text": "Егор стоит у твоей двери."
 },
 {
  "i": 80,
  "start": 234.2,
  "end": 236.18,
  "text": "В руках у него переноска люлька."
 },
 {
  "i": 81,
  "start": 236.86,
  "end": 238.98,
  "text": "Знакомься, говорит он тихо."
 },
 {
  "i": 82,
  "start": 239.16,
  "end": 240.16,
  "text": "Это Максим."
 },
 {
  "i": 83,
  "start": 240.6,
  "end": 245.6,
  "text": "Ты смотришь на ребенка, которому, судя по всему, уже несколько месяцев и спрашиваешь."
 },
 {
  "i": 84,
  "start": 245.94,
  "end": 247.76,
  "text": "Вы назвали его в мою честь?"
 },
 {
  "i": 85,
  "start": 248.18,
  "end": 249.24,
  "text": "Егор улыбается."
 },
 {
  "i": 86,
  "start": 249.6,
  "end": 250.32,
  "text": "Ты крестный."
 },
 {
  "i": 87,
  "start": 250.6,
  "end": 252.42,
  "text": "Ты держал его на крестинах."
 },
 {
  "i": 88,
  "start": 252.44,
  "end": 253.9,
  "text": "Плакал больше всех."
 },
 {
  "i": 89,
  "start": 253.9,
  "end": 256.52,
  "text": "Ты ничего из этого не помнишь."
 },
 {
  "i": 90,
  "start": 256.62,
  "end": 258.02,
  "text": "Тебе 24."
 },
 {
  "i": 91,
  "start": 258.56,
  "end": 261.94,
  "text": "Вот тут тебе становится по -настоящему страшно."
 },
 {
  "i": 92,
  "start": 262.16,
  "end": 265.32,
  "text": "Не из -за потерянных лет, а потому что ты понимаешь."
 },
 {
  "i": 93,
  "start": 265.66,
  "end": 268.72,
  "text": "Егор не просто так дошел до этого момента."
 },
 {
  "i": 94,
  "start": 268.86,
  "end": 271.82,
  "text": "Каждый раз, когда ты моргал, он оставался рядом."
 },
 {
  "i": 95,
  "start": 272.2,
  "end": 275.44,
  "text": "Он прожил весь этот год и со мной, и без меня."
 },
 {
  "i": 96,
  "start": 275.64,
  "end": 276.94,
  "text": "И ни разу не бросил."
 },
 {
  "i": 97,
  "start": 277.4,
  "end": 281.18,
  "text": "Егор сразу покупает в аптеке капли за 490 рублей."
 },
 {
  "i": 98,
  "start": 281.18,
  "end": 285.22,
  "text": "Вы сидите на скамейке и пытаетесь не моргать, как два кота."
 },
 {
  "i": 99,
  "start": 285.54,
  "end": 288.22,
  "text": "Тебе кажется, что у тебя глаза сейчас вывалятся."
 },
 {
  "i": 100,
  "start": 288.66,
  "end": 291.68,
  "text": "Егор достает из кармана секундомер и засекает."
 },
 {
  "i": 101,
  "start": 291.98,
  "end": 294.32,
  "text": "Одна минута, две минуты."
 },
 {
  "i": 102,
  "start": 294.56,
  "end": 295.78,
  "text": "Слезы текут сами."
 },
 {
  "i": 103,
  "start": 296.0,
  "end": 299.48,
  "text": "И ты, наконец, понимаешь, зачем людям нужно моргать."
 },
 {
  "i": 104,
  "start": 299.84,
  "end": 302.62,
  "text": "На третьей минуте Егор задумывается и говорит."
 },
 {
  "i": 105,
  "start": 303.08,
  "end": 306.16,
  "text": "Подожди, ты каждый раз перед этим что -то говорил."
 },
 {
  "i": 106,
  "start": 306.4,
  "end": 308.18,
  "text": "Я только сейчас вспомнил."
 },
 {
  "i": 107,
  "start": 308.32,
  "end": 308.72,
  "text": "Что?"
 },
 {
  "i": 108,
  "start": 309.1,
  "end": 309.9,
  "text": "Не помню."
 },
 {
  "i": 109,
  "start": 309.9,
  "end": 311.86,
  "text": "Но ты всегда вздыхал."
 },
 {
  "i": 110,
  "start": 312.16,
  "end": 315.94,
  "text": "Ты возвращаешься в салон и не моргаешь уже четвертый час."
 },
 {
  "i": 111,
  "start": 316.16,
  "end": 318.24,
  "text": "Держишься на каплях и упрямстве."
 },
 {
  "i": 112,
  "start": 318.64,
  "end": 321.98,
  "text": "Но на втором часу ты слышишь у себя за спиной знакомое."
 },
 {
  "i": 113,
  "start": 322.36,
  "end": 324.44,
  "text": "Максим, премия на этой неделе!"
 },
 {
  "i": 114,
  "start": 324.76,
  "end": 328.9,
  "text": "Ты не выдерживаешь, злишься, жмуришься на секунду и думаешь."
 },
 {
  "i": 115,
  "start": 329.16,
  "end": 330.68,
  "text": "Ну, давай уже, хватит!"
 },
 {
  "i": 116,
  "start": 330.88,
  "end": 331.78,
  "text": "И моргаешь."
 },
 {
  "i": 117,
  "start": 332.14,
  "end": 333.28,
  "text": "Ты открываешь глаза."
 },
 {
  "i": 118,
  "start": 333.72,
  "end": 335.02,
  "text": "Тебе 25."
 },
 {
  "i": 119,
  "start": 335.36,
  "end": 341.66,
  "text": "Салон перекрашен, на ресепшене стоит какая -то новая девушка, а Сергей Николаевич стоит и говорит."
 },
 {
  "i": 120,
  "start": 342.04,
  "end": 344.28,
  "text": "Максим, премия в этом месяце!"
 },
 {
  "i": 121,
  "start": 344.44,
  "end": 345.32,
  "text": "Прямо точно!"
 },
 {
  "i": 122,
  "start": 345.86,
  "end": 348.68,
  "text": "В этот раз ты решаешь довести всё до конца."
 },
 {
  "i": 123,
  "start": 349.04,
  "end": 353.12,
  "text": "Егор приходит прямо в салон, встаёт рядом с пипеткой и шепчет."
 },
 {
  "i": 124,
  "start": 353.44,
  "end": 354.14,
  "text": "Выдержим."
 },
 {
  "i": 125,
  "start": 354.32,
  "end": 355.46,
  "text": "Ещё чуть -чуть."
 },
 {
  "i": 126,
  "start": 355.98,
  "end": 356.98,
  "text": "Ты не моргаешь."
 },
 {
  "i": 127,
  "start": 357.44,
  "end": 358.16,
  "text": "Минуту."
 },
 {
  "i": 128,
  "start": 358.28,
  "end": 359.3,
  "text": "Две минуты."
 },
 {
  "i": 129,
  "start": 359.4,
  "end": 359.82,
  "text": "Три."
 },
 {
  "i": 130,
  "start": 360.18,
  "end": 361.74,
  "text": "По щеке течёт слеза."
 },
 {
  "i": 131,
  "start": 362.16,
  "end": 365.06,
  "text": "Сергей Николаевич идёт к тебе с белым конвертом."
 },
 {
  "i": 132,
  "start": 365.36,
  "end": 367.1,
  "text": "И вот мои вернулись."
 },
 {
  "i": 133,
  "start": 367.1,
  "end": 372.82,
  "text": "Ты стоишь посреди автосалона на Кутузовском проспекте, не моргая четвёртую минуту."
 },
 {
  "i": 134,
  "start": 373.14,
  "end": 375.74,
  "text": "Сергей Николаевич протягивает конверт."
 },
 {
  "i": 135,
  "start": 375.84,
  "end": 377.4,
  "text": "Максим, твоя премия."
 },
 {
  "i": 136,
  "start": 377.74,
  "end": 378.52,
  "text": "Почти."
 },
 {
  "i": 137,
  "start": 378.68,
  "end": 379.3,
  "text": "Почти?"
 },
 {
  "i": 138,
  "start": 379.64,
  "end": 381.12,
  "text": "63 тысячи?"
 },
 {
  "i": 139,
  "start": 381.36,
  "end": 382.94,
  "text": "Вместо 60 тысяч?"
 },
 {
  "i": 140,
  "start": 383.44,
  "end": 385.66,
  "text": "Егор наклоняется к тебе и шепчет."
 },
 {
  "i": 141,
  "start": 385.96,
  "end": 387.64,
  "text": "Максим, я всё понял."
 },
 {
  "i": 142,
  "start": 387.98,
  "end": 391.68,
  "text": "Перед каждым разом ты вздыхал и говорил «скорее бы»."
 },
 {
  "i": 143,
  "start": 391.68,
  "end": 393.46,
  "text": "Четыре раза из четырёх."
 },
 {
  "i": 144,
  "start": 393.66,
  "end": 396.14,
  "text": "Не после чихания, не от усталости."
 },
 {
  "i": 145,
  "start": 396.14,
  "end": 399.54,
  "text": "Только когда ты хотел, чтобы время побыстрее прошло."
 },
 {
  "i": 146,
  "start": 399.86,
  "end": 400.96,
  "text": "Ты замираешь."
 },
 {
  "i": 147,
  "start": 401.14,
  "end": 402.5,
  "text": "Все четыре раза."
 },
 {
  "i": 148,
  "start": 402.98,
  "end": 404.08,
  "text": "Скорее бы вечер."
 },
 {
  "i": 149,
  "start": 404.24,
  "end": 405.76,
  "text": "Ну когда уже эта премия?"
 },
 {
  "i": 150,
  "start": 406.08,
  "end": 407.34,
  "text": "Скорее бы выходные."
 },
 {
  "i": 151,
  "start": 407.62,
  "end": 408.98,
  "text": "Давай уже, хватит!"
 },
 {
  "i": 152,
  "start": 409.2,
  "end": 411.08,
  "text": "Ты не терял год от моргания."
 },
 {
  "i": 153,
  "start": 411.36,
  "end": 412.76,
  "text": "Ты отдавал его сам."
 },
 {
  "i": 154,
  "start": 412.96,
  "end": 415.82,
  "text": "Каждый раз, когда просил, чтобы он закончился."
 },
 {
  "i": 155,
  "start": 416.26,
  "end": 417.54,
  "text": "Глаза у тебя горят."
 },
 {
  "i": 156,
  "start": 417.72,
  "end": 419.06,
  "text": "Ты смотришь на Егора."
 },
 {
  "i": 157,
  "start": 419.24,
  "end": 420.06,
  "text": "На конверт."
 },
 {
  "i": 158,
  "start": 420.2,
  "end": 421.44,
  "text": "На красный кроссовер."
 },
 {
  "i": 159,
  "start": 421.6,
  "end": 425.9,
  "text": "На Сергея Николаевича, который всё ещё стоит с идиотской надеждой на лице."
 },
 {
  "i": 160,
  "start": 425.9,
  "end": 430.82,
  "text": "И в голове ты впервые за много недель говоришь совсем другое."
 },
 {
  "i": 161,
  "start": 430.86,
  "end": 432.28,
  "text": "Пусть будет сегодня."
 },
 {
  "i": 162,
  "start": 432.6,
  "end": 435.28,
  "text": "Пусть этот день будет именно этим."
 },
 {
  "i": 163,
  "start": 435.7,
  "end": 436.62,
  "text": "И моргаешь."
 },
 {
  "i": 164,
  "start": 437.02,
  "end": 438.3,
  "text": "Ничего не происходит."
 },
 {
  "i": 165,
  "start": 438.7,
  "end": 442.2,
  "text": "Тот же салон, тот же календарь, тот же Егор рядом."
 },
 {
  "i": 166,
  "start": 442.64,
  "end": 444.22,
  "text": "Сергей Николаевич хмурится."
 },
 {
  "i": 167,
  "start": 444.62,
  "end": 445.66,
  "text": "Ты чего моргаешь?"
 },
 {
  "i": 168,
  "start": 446.0,
  "end": 449.94,
  "text": "А Егор складывается пополам от смеха и вытирает слёзы рукавом."
 },
 {
  "i": 169,
  "start": 450.26,
  "end": 455.06,
  "text": "Первый раз за четыре года ты моргаешь просто так, как нормальный человек."
 },
 {
  "i": 170,
  "start": 455.06,
  "end": 457.8,
  "text": "И это лучшее чувство в твоей жизни."
 },
 {
  "i": 171,
  "start": 458.16,
  "end": 459.74,
  "text": "Ты вскрываешь конверт."
 },
 {
  "i": 172,
  "start": 459.8,
  "end": 462.4,
  "text": "Внутри три тысячи рублей и записка."
 },
 {
  "i": 173,
  "start": 462.6,
  "end": 464.66,
  "text": "Остальное в следующем месяце."
 },
 {
  "i": 174,
  "start": 464.96,
  "end": 468.36,
  "text": "Ты смотришь на неё и вдруг начинаешь смеяться тоже."
 },
 {
  "i": 175,
  "start": 468.8,
  "end": 470.78,
  "text": "В субботу ты приезжаешь к Егору."
 },
 {
  "i": 176,
  "start": 471.12,
  "end": 474.06,
  "text": "Маленький Максим сидит на ковре и тянет к тебе руки."
 },
 {
  "i": 177,
  "start": 474.42,
  "end": 480.92,
  "text": "Ты не помнишь, как держал его на крестинах, но сейчас ты берёшь его на руки и это уже твой момент."
 },
 {
  "i": 178,
  "start": 481.16,
  "end": 483.26,
  "text": "И никто не заберёт его у тебя."
 },
 {
  "i": 179,
  "start": 483.26,
  "end": 488.74,
  "text": "Итак, какой год ты бы согласился пропустить, а какой не отдал бы ни за что?"
 },
 {
  "i": 180,
  "start": 489.18,
  "end": 490.34,
  "text": "Напиши в комментариях."
 },
 {
  "i": 181,
  "start": 490.58,
  "end": 496.88,
  "text": "И подписывайся, потому что Сергей Николаевич обещал, что следующая серия выйдет в следующем месяце."
 },
 {
  "i": 182,
  "start": 497.38,
  "end": 500.74,
  "text": "Каждая история начинается со слова «если»."
 }
]