[
 {
  "i": 0,
  "start": 0.0,
  "end": 4.92,
  "text": "Утром ты выходишь из подъезда, и над головой соседа горят зелёные цифры."
 },
 {
  "i": 1,
  "start": 5.26,
  "end": 9.7,
  "text": "У продавщицы в ларьке – жёлтые, в метро – сотни таймеров."
 },
 {
  "i": 2,
  "start": 10.3,
  "end": 12.78,
  "text": "Ты видишь, сколько каждому осталось жить."
 },
 {
  "i": 3,
  "start": 13.34,
  "end": 16.5,
  "text": "А вечером к тебе заходит Лёха, твой лучший друг."
 },
 {
  "i": 4,
  "start": 17.02,
  "end": 17.96,
  "text": "Ему 25."
 },
 {
  "i": 5,
  "start": 18.36,
  "end": 21.2,
  "text": "И над его головой горит красный таймер."
 },
 {
  "i": 6,
  "start": 22.04,
  "end": 22.7,
  "text": "Сорок дней."
 },
 {
  "i": 7,
  "start": 23.1,
  "end": 26.18,
  "text": "У тебя сорок дней, чтобы понять, что его убьёт."
 },
 {
  "i": 8,
  "start": 26.36,
  "end": 27.62,
  "text": "И ни одной подсказки."
 },
 {
  "i": 9,
  "start": 27.62,
  "end": 31.7,
  "text": "Только цифры, которые с каждой секундой становятся меньше."
 },
 {
  "i": 10,
  "start": 32.88,
  "end": 33.76,
  "text": "Давай по порядку."
 },
 {
  "i": 11,
  "start": 34.2,
  "end": 35.12,
  "text": "Правила простые."
 },
 {
  "i": 12,
  "start": 35.24,
  "end": 38.78,
  "text": "Над каждым человеком висит таймер, сколько ему осталось жить."
 },
 {
  "i": 13,
  "start": 39.2,
  "end": 40.7,
  "text": "Меньше пяти лет – красный."
 },
 {
  "i": 14,
  "start": 40.92,
  "end": 43.04,
  "text": "От пяти до пятнадцати – жёлтый."
 },
 {
  "i": 15,
  "start": 43.34,
  "end": 45.14,
  "text": "Больше пятнадцати – зелёный."
 },
 {
  "i": 16,
  "start": 45.54,
  "end": 47.9,
  "text": "От чего человек умрёт, таймер не говорит."
 },
 {
  "i": 17,
  "start": 48.32,
  "end": 49.0,
  "text": "И ещё одно."
 },
 {
  "i": 18,
  "start": 49.2,
  "end": 51.64,
  "text": "Ты видишь все таймеры, кроме своего."
 },
 {
  "i": 19,
  "start": 52.38,
  "end": 54.52,
  "text": "Сначала ты думаешь, что сошёл с ума."
 },
 {
  "i": 20,
  "start": 54.52,
  "end": 59.76,
  "text": "Возвращаешься домой, умываешься холодной водой, цифры за окном никуда не деваются."
 },
 {
  "i": 21,
  "start": 60.18,
  "end": 61.9,
  "text": "Тогда ты подходишь к зеркалу."
 },
 {
  "i": 22,
  "start": 61.92,
  "end": 63.76,
  "text": "Над твоей головой пусто."
 },
 {
  "i": 23,
  "start": 64.06,
  "end": 65.56,
  "text": "Ни цифр, ни цвета."
 },
 {
  "i": 24,
  "start": 65.8,
  "end": 67.58,
  "text": "Ты фотографируешь себя на телефон."
 },
 {
  "i": 25,
  "start": 68.72,
  "end": 69.36,
  "text": "Пусто."
 },
 {
  "i": 26,
  "start": 69.6,
  "end": 72.4,
  "text": "Ты снова выходишь на улицу и начинаешь смотреть."
 },
 {
  "i": 27,
  "start": 72.84,
  "end": 74.2,
  "text": "Над детьми на площадке."
 },
 {
  "i": 28,
  "start": 74.3,
  "end": 75.98,
  "text": "Длинные зелёные числа."
 },
 {
  "i": 29,
  "start": 76.14,
  "end": 76.94,
  "text": "Семьдесят лет."
 },
 {
  "i": 30,
  "start": 77.02,
  "end": 77.72,
  "text": "Семьдесят пять."
 },
 {
  "i": 31,
  "start": 78.14,
  "end": 79.76,
  "text": "А над мужчинами средних лет."
 },
 {
  "i": 32,
  "start": 79.98,
  "end": 82.56,
  "text": "Жёлтый горит заметно чаще, чем над ивжонами."
 },
 {
  "i": 33,
  "start": 82.86,
  "end": 84.1,
  "text": "И это не случайность."
 },
 {
  "i": 34,
  "start": 84.1,
  "end": 88.88,
  "text": "Средняя продолжительность жизни в России сейчас почти семьдесят три года."
 },
 {
  "i": 35,
  "start": 89.24,
  "end": 94.92,
  "text": "Но женщины в среднем живут больше 78 лет, а мужчины примерно на десять лет меньше."
 },
 {
  "i": 36,
  "start": 95.38,
  "end": 99.22,
  "text": "И ты буквально видишь эту разницу над головами людей на остановке."
 },
 {
  "i": 37,
  "start": 99.54,
  "end": 101.38,
  "text": "А ещё ты замечаешь странное."
 },
 {
  "i": 38,
  "start": 101.66,
  "end": 103.44,
  "text": "Красный – это не всегда грустно."
 },
 {
  "i": 39,
  "start": 103.76,
  "end": 106.08,
  "text": "Вот две бабушки на лавочке у подъезда."
 },
 {
  "i": 40,
  "start": 106.22,
  "end": 107.58,
  "text": "Над одной красный таймер."
 },
 {
  "i": 41,
  "start": 107.7,
  "end": 108.76,
  "text": "Три года с небольшим."
 },
 {
  "i": 42,
  "start": 108.94,
  "end": 112.56,
  "text": "А она хохочет так, что на неё оборачиваются голуби."
 },
 {
  "i": 43,
  "start": 112.64,
  "end": 113.42,
  "text": "Она не знает."
 },
 {
  "i": 44,
  "start": 113.42,
  "end": 115.38,
  "text": "И может, это и к лучшему."
 },
 {
  "i": 45,
  "start": 115.96,
  "end": 118.54,
  "text": "А вот пожилая пара идёт под руку из магазина."
 },
 {
  "i": 46,
  "start": 118.84,
  "end": 121.4,
  "text": "Он несёт пакет, она держит его за локоть."
 },
 {
  "i": 47,
  "start": 121.68,
  "end": 123.48,
  "text": "Над обоями – красные таймеры."
 },
 {
  "i": 48,
  "start": 123.62,
  "end": 125.16,
  "text": "И цифры почти одинаковые."
 },
 {
  "i": 49,
  "start": 125.4,
  "end": 128.52,
  "text": "Его заканчивается всего на пару месяцев раньше, чем её."
 },
 {
  "i": 50,
  "start": 129.3,
  "end": 132.54,
  "text": "Ты потом прочитаешь, что у этого есть научное название."
 },
 {
  "i": 51,
  "start": 132.74,
  "end": 133.98,
  "text": "Эффект вдовства."
 },
 {
  "i": 52,
  "start": 134.6,
  "end": 141.94,
  "text": "Учёные из Гарварда больше десяти лет наблюдали больше, чем за двенадцатью тысячами женатых и замужних людей старше пятидесяти лет."
 },
 {
  "i": 53,
  "start": 141.94,
  "end": 149.6,
  "text": "И выяснили, в первые три месяца после смерти супруга риск умереть у оставшегося выше примерно на две трети."
 },
 {
  "i": 54,
  "start": 149.98,
  "end": 154.76,
  "text": "Как будто люди, прожившие вместе всю жизнь, и правда держат друг друга на этом свете."
 },
 {
  "i": 55,
  "start": 155.3,
  "end": 156.68,
  "text": "А потом метро."
 },
 {
  "i": 56,
  "start": 156.94,
  "end": 157.52,
  "text": "Час пик."
 },
 {
  "i": 57,
  "start": 157.64,
  "end": 161.76,
  "text": "Ты стоишь в вагоне и рассматриваешь цифры, будто листаешь чужие жизни."
 },
 {
  "i": 58,
  "start": 162.36,
  "end": 163.52,
  "text": "И вдруг замечаешь."
 },
 {
  "i": 59,
  "start": 163.94,
  "end": 166.24,
  "text": "Над мужчиной у дверей красный таймер."
 },
 {
  "i": 60,
  "start": 166.68,
  "end": 168.52,
  "text": "Ни годы, ни дни."
 },
 {
  "i": 61,
  "start": 168.72,
  "end": 169.48,
  "text": "Девять минут."
 },
 {
  "i": 62,
  "start": 169.98,
  "end": 171.22,
  "text": "Восемь пятьдесят девять."
 },
 {
  "i": 63,
  "start": 171.22,
  "end": 173.78,
  "text": "Восемь пятьдесят восемь."
 },
 {
  "i": 64,
  "start": 173.86,
  "end": 177.7,
  "text": "Мужчина лет пятидесяти, обычный, в наушниках с пакетом."
 },
 {
  "i": 65,
  "start": 178.04,
  "end": 180.6,
  "text": "Он не выглядит больным и ничего не подозревает."
 },
 {
  "i": 66,
  "start": 180.94,
  "end": 183.98,
  "text": "А ты смотришь, как бегут секунды и не знаешь, что делать."
 },
 {
  "i": 67,
  "start": 184.38,
  "end": 184.86,
  "text": "Подойти?"
 },
 {
  "i": 68,
  "start": 185.16,
  "end": 187.96,
  "text": "Сказать «извините, вы сейчас умрёте ?»."
 },
 {
  "i": 69,
  "start": 187.96,
  "end": 189.24,
  "text": "На станции он выходит."
 },
 {
  "i": 70,
  "start": 189.54,
  "end": 190.5,
  "text": "Ты за ним."
 },
 {
  "i": 71,
  "start": 191.0,
  "end": 197.8,
  "text": "Таймер показывает шесть минут, когда мужчина вдруг останавливается посреди платформы, хватается за грудь и падает."
 },
 {
  "i": 72,
  "start": 197.8,
  "end": 199.04,
  "text": "Вокруг люди."
 },
 {
  "i": 73,
  "start": 199.2,
  "end": 202.32,
  "text": "Кто -то ахает, кто -то достаёт телефон, чтобы снимать."
 },
 {
  "i": 74,
  "start": 202.56,
  "end": 205.66,
  "text": "А ты вспоминаешь занятия по первой помощи в автошколе."
 },
 {
  "i": 75,
  "start": 205.8,
  "end": 207.34,
  "text": "То самое, на котором ты зевал."
 },
 {
  "i": 76,
  "start": 207.76,
  "end": 210.16,
  "text": "Проверить, дышит ли, не дышит."
 },
 {
  "i": 77,
  "start": 210.32,
  "end": 211.9,
  "text": "Крикнуть, чтобы вызвали скорую."
 },
 {
  "i": 78,
  "start": 212.16,
  "end": 215.36,
  "text": "Одну ладонь на середину груди, вторую сверху."
 },
 {
  "i": 79,
  "start": 215.4,
  "end": 216.04,
  "text": "И давить."
 },
 {
  "i": 80,
  "start": 216.16,
  "end": 217.3,
  "text": "Сильно и быстро."
 },
 {
  "i": 81,
  "start": 217.74,
  "end": 219.58,
  "text": "Сто сто двадцать раз в минуту."
 },
 {
  "i": 82,
  "start": 219.6,
  "end": 221.86,
  "text": "На пять -шесть сантиметров вглубь."
 },
 {
  "i": 83,
  "start": 221.98,
  "end": 223.88,
  "text": "Ты давишь и смотришь на таймер."
 },
 {
  "i": 84,
  "start": 224.02,
  "end": 226.12,
  "text": "И видишь то, чего никак не ожидал."
 },
 {
  "i": 85,
  "start": 226.12,
  "end": 227.68,
  "text": "Цифры мигают."
 },
 {
  "i": 86,
  "start": 227.94,
  "end": 228.56,
  "text": "Прыгают."
 },
 {
  "i": 87,
  "start": 228.94,
  "end": 229.84,
  "text": "Две минуты."
 },
 {
  "i": 88,
  "start": 229.96,
  "end": 230.48,
  "text": "Пять."
 },
 {
  "i": 89,
  "start": 230.72,
  "end": 231.38,
  "text": "Снова три."
 },
 {
  "i": 90,
  "start": 231.8,
  "end": 234.48,
  "text": "Будто таймер сам не может решить, что будет дальше."
 },
 {
  "i": 91,
  "start": 234.92,
  "end": 240.0,
  "text": "Через несколько минут, которые кажутся тебе вечностью, прибегают медики с дефибриллятором."
 },
 {
  "i": 92,
  "start": 240.0,
  "end": 240.46,
  "text": "Разряд."
 },
 {
  "i": 93,
  "start": 240.76,
  "end": 241.44,
  "text": "Ещё один."
 },
 {
  "i": 94,
  "start": 241.74,
  "end": 244.18,
  "text": "И таймер над мужчиной перестаёт мигать."
 },
 {
  "i": 95,
  "start": 244.5,
  "end": 245.84,
  "text": "Он жёлтый."
 },
 {
  "i": 96,
  "start": 247.87,
  "end": 248.85,
  "text": "Одиннадцать лет."
 },
 {
  "i": 97,
  "start": 249.03,
  "end": 251.35,
  "text": "Ты сидишь на холодном полу платформы."
 },
 {
  "i": 98,
  "start": 251.63,
  "end": 252.49,
  "text": "Руки дрожат."
 },
 {
  "i": 99,
  "start": 252.75,
  "end": 254.19,
  "text": "И до тебя доходит главное."
 },
 {
  "i": 100,
  "start": 254.51,
  "end": 256.01,
  "text": "Таймер – не приговор."
 },
 {
  "i": 101,
  "start": 256.27,
  "end": 257.03,
  "text": "Это прогноз."
 },
 {
  "i": 102,
  "start": 257.03,
  "end": 260.97,
  "text": "Сколько человеку осталось, если всё пойдёт так, как идёт."
 },
 {
  "i": 103,
  "start": 261.07,
  "end": 263.45,
  "text": "Если вмешаться, цифры меняются."
 },
 {
  "i": 104,
  "start": 263.79,
  "end": 267.51,
  "text": "Но только когда ты что -то сделал, а не когда только собрался."
 },
 {
  "i": 105,
  "start": 267.79,
  "end": 269.23,
  "text": "И это не фантастика."
 },
 {
  "i": 106,
  "start": 269.49,
  "end": 275.57,
  "text": "При остановке сердца каждая минута без помощи снижает шансы выжить примерно на семь -десять процентов."
 },
 {
  "i": 107,
  "start": 275.75,
  "end": 281.01,
  "text": "А если человек рядом сразу начинает давить на грудь, шансы вырастают в два -три раза."
 },
 {
  "i": 108,
  "start": 281.21,
  "end": 281.85,
  "text": "Ты не врач."
 },
 {
  "i": 109,
  "start": 282.05,
  "end": 284.37,
  "text": "Ты просто оказался рядом и не прошёл мимо."
 },
 {
  "i": 110,
  "start": 284.37,
  "end": 288.03,
  "text": "После метро ты не можешь просто ходить мимо красных цифр."
 },
 {
  "i": 111,
  "start": 288.35,
  "end": 290.99,
  "text": "Через час у кофейни ты видишь женщину лет сорока."
 },
 {
  "i": 112,
  "start": 291.23,
  "end": 292.89,
  "text": "Над ней красный таймер."
 },
 {
  "i": 113,
  "start": 293.09,
  "end": 294.51,
  "text": "Год и два месяца."
 },
 {
  "i": 114,
  "start": 294.79,
  "end": 297.27,
  "text": "Она смеётся в телефон и выбирает пирожное."
 },
 {
  "i": 115,
  "start": 297.49,
  "end": 301.55,
  "text": "Ты подходишь и, запинаясь, говоришь «Извините, вам нужно обследоваться."
 },
 {
  "i": 116,
  "start": 301.71,
  "end": 302.19,
  "text": "Срочно."
 },
 {
  "i": 117,
  "start": 302.75,
  "end": 303.37,
  "text": "Пожалуйста»."
 },
 {
  "i": 118,
  "start": 303.37,
  "end": 307.37,
  "text": "Женщина смотрит на тебя так, будто ты предлагаешь ей купить чудо -браслет."
 },
 {
  "i": 119,
  "start": 307.57,
  "end": 312.51,
  "text": "«Молодой человек, вы из какой секты ?» Она забирает пирожное и уходит, оглядываясь."
 },
 {
  "i": 120,
  "start": 312.51,
  "end": 314.61,
  "text": "Таймер над ней не меняется."
 },
 {
  "i": 121,
  "start": 315.09,
  "end": 317.31,
  "text": "И ты понимаешь ещё одно правило."
 },
 {
  "i": 122,
  "start": 317.55,
  "end": 319.93,
  "text": "Слова сами по себе ничего не меняют."
 },
 {
  "i": 123,
  "start": 320.17,
  "end": 322.25,
  "text": "Меняет только то, что человек сделает."
 },
 {
  "i": 124,
  "start": 322.71,
  "end": 328.21,
  "text": "А заставить другого что -то сделать гораздо труднее, чем самому давить на чужую грудь в метро."
 },
 {
  "i": 125,
  "start": 329.33,
  "end": 331.49,
  "text": "До работы ты добираешься только к обеду."
 },
 {
  "i": 126,
  "start": 331.69,
  "end": 334.15,
  "text": "В опенспейсе над всеми коллегами горит зелёный."
 },
 {
  "i": 127,
  "start": 334.53,
  "end": 337.09,
  "text": "Тридцать лет, сорок два, пятьдесят один."
 },
 {
  "i": 128,
  "start": 337.49,
  "end": 338.97,
  "text": "У всех полно времени."
 },
 {
  "i": 129,
  "start": 338.97,
  "end": 342.41,
  "text": "И все тратят его так, будто его бесконечно."
 },
 {
  "i": 130,
  "start": 342.77,
  "end": 346.07,
  "text": "Ругаются из -за чата, листают ленту, ждут пятницы."
 },
 {
  "i": 131,
  "start": 346.61,
  "end": 348.51,
  "text": "Ты сам ещё вчера был таким же."
 },
 {
  "i": 132,
  "start": 349.15,
  "end": 353.31,
  "text": "А вечером к тебе заходит Лёха, довольный со шлемом под мышкой."
 },
 {
  "i": 133,
  "start": 353.75,
  "end": 362.37,
  "text": "«Тёма, я его купил, мотоцикл, поехали кататься !» И сразу рассказывает про финал городского турнира по футболу, в конце следующего месяца."
 },
 {
  "i": 134,
  "start": 362.83,
  "end": 364.67,
  "text": "Его команда шла к нему целый год."
 },
 {
  "i": 135,
  "start": 365.23,
  "end": 368.47,
  "text": "А ты не слышишь ни слова, ты смотришь над его головой."
 },
 {
  "i": 136,
  "start": 368.47,
  "end": 369.51,
  "text": "Красный."
 },
 {
  "i": 137,
  "start": 369.63,
  "end": 370.47,
  "text": "Сорок дней."
 },
 {
  "i": 138,
  "start": 370.75,
  "end": 372.73,
  "text": "Ноль часов, двенадцать минут."
 },
 {
  "i": 139,
  "start": 373.91,
  "end": 375.61,
  "text": "Первая мысль – мотоцикл."
 },
 {
  "i": 140,
  "start": 375.85,
  "end": 377.33,
  "text": "Конечно, мотоцикл."
 },
 {
  "i": 141,
  "start": 377.67,
  "end": 380.39,
  "text": "Ты весь вечер отговариваешь Лёху, он смеётся."
 },
 {
  "i": 142,
  "start": 380.79,
  "end": 387.43,
  "text": "Тогда ты идёшь на хитрость, говоришь, что твою машину забрали в ремонт, и тебе по зарез нужен транспорт на месяц."
 },
 {
  "i": 143,
  "start": 387.69,
  "end": 389.89,
  "text": "Лёха вздыхает и отдаёт ключи."
 },
 {
  "i": 144,
  "start": 389.99,
  "end": 391.17,
  "text": "Только аккуратно, Тём."
 },
 {
  "i": 145,
  "start": 392.15,
  "end": 393.81,
  "text": "Наутро ты смотришь на таймер."
 },
 {
  "i": 146,
  "start": 394.05,
  "end": 395.37,
  "text": "Тридцать девять дней."
 },
 {
  "i": 147,
  "start": 395.87,
  "end": 397.09,
  "text": "Ничего не изменилось."
 },
 {
  "i": 148,
  "start": 397.77,
  "end": 399.01,
  "text": "Не мотоцикл."
 },
 {
  "i": 149,
  "start": 399.91,
  "end": 402.63,
  "text": "Через пару дней в воскресенье ты едешь к родителям."
 },
 {
  "i": 150,
  "start": 402.91,
  "end": 408.55,
  "text": "Над мамой – спокойный зелёный, двадцать девять лет, а над папой – жёлтый, десять лет."
 },
 {
  "i": 151,
  "start": 408.99,
  "end": 412.07,
  "text": "Папе – пятьдесят четыре, он курит семнадцати."
 },
 {
  "i": 152,
  "start": 412.71,
  "end": 415.89,
  "text": "Курение отнимает у человека в среднем около десяти лет жизни."
 },
 {
  "i": 153,
  "start": 416.29,
  "end": 417.69,
  "text": "Но есть и хорошая новость."
 },
 {
  "i": 154,
  "start": 418.01,
  "end": 423.91,
  "text": "Большое исследование, в котором учёные проследили за жизнью больше, чем двухсот тысяч американцев, показало."
 },
 {
  "i": 155,
  "start": 423.91,
  "end": 431.79,
  "text": "Тот, кто бросает курить между сорока пятью и пятью десятью четырьмя годами, возвращает в среднем около шести лет."
 },
 {
  "i": 156,
  "start": 432.67,
  "end": 434.63,
  "text": "Сказать папе про таймер ты не можешь."
 },
 {
  "i": 157,
  "start": 435.05,
  "end": 437.67,
  "text": "Поэтому выходишь к нему на балкон и говоришь по -другому."
 },
 {
  "i": 158,
  "start": 437.93,
  "end": 440.67,
  "text": "«Пап, я хочу, чтобы ты был на моей свадьбе."
 },
 {
  "i": 159,
  "start": 440.67,
  "end": 442.87,
  "text": "И чтобы потом учил моих детей рыбачить."
 },
 {
  "i": 160,
  "start": 443.01,
  "end": 447.83,
  "text": "Брось, а ?» Папа долго молчит, а потом тушит сигарету оперила."
 },
 {
  "i": 161,
  "start": 448.63,
  "end": 451.19,
  "text": "А с Лёхой ты по -прежнему не понимаешь, в чём дело."
 },
 {
  "i": 162,
  "start": 451.75,
  "end": 454.23,
  "text": "Ты начинаешь следить за Лёхой как детектив."
 },
 {
  "i": 163,
  "start": 454.61,
  "end": 458.51,
  "text": "Проверяешь, пристёгивается ли он в такси, отговариваешь от ночных прогулок."
 },
 {
  "i": 164,
  "start": 458.85,
  "end": 460.03,
  "text": "Таймер не шелохнётся."
 },
 {
  "i": 165,
  "start": 460.53,
  "end": 461.61,
  "text": "Тридцать пять дней."
 },
 {
  "i": 166,
  "start": 462.07,
  "end": 462.63,
  "text": "Тридцать."
 },
 {
  "i": 167,
  "start": 463.01,
  "end": 469.93,
  "text": "Ты даже приходишь к нему домой с новым датчиком дыма и ставишь его под потолок, пока Лёха смотрит на тебя как на сумасшедшего."
 },
 {
  "i": 168,
  "start": 470.39,
  "end": 471.99,
  "text": "Проверяешь, не течёт ли газ."
 },
 {
  "i": 169,
  "start": 472.43,
  "end": 474.13,
  "text": "Покупаешь ему шлем для самоката."
 },
 {
  "i": 170,
  "start": 474.49,
  "end": 477.17,
  "text": "Лёха говорит, что ты стал хуже его бабушки."
 },
 {
  "i": 171,
  "start": 477.69,
  "end": 480.45,
  "text": "А таймер всё так же тихо отсчитывает дни."
 },
 {
  "i": 172,
  "start": 480.98,
  "end": 483.21,
  "text": "В субботу ты едешь к дедушке на дачу."
 },
 {
  "i": 173,
  "start": 483.37,
  "end": 484.49,
  "text": "Ему восемьдесят два."
 },
 {
  "i": 174,
  "start": 484.85,
  "end": 486.43,
  "text": "Над ним красный таймер."
 },
 {
  "i": 175,
  "start": 486.65,
  "end": 487.97,
  "text": "Год и семь месяцев."
 },
 {
  "i": 176,
  "start": 488.43,
  "end": 491.77,
  "text": "Ты знал, что так будет, но горло всё равно сжимается."
 },
 {
  "i": 177,
  "start": 492.67,
  "end": 496.35,
  "text": "Дедушка вручает тебе лопату, и вы молча копаете грядку."
 },
 {
  "i": 178,
  "start": 496.91,
  "end": 498.35,
  "text": "А потом он вдруг спрашивает."
 },
 {
  "i": 179,
  "start": 498.67,
  "end": 501.21,
  "text": "Ты чего такой, Тёма, будто похороны увидел?"
 },
 {
  "i": 180,
  "start": 501.81,
  "end": 503.15,
  "text": "И ты не выдерживаешь."
 },
 {
  "i": 181,
  "start": 503.49,
  "end": 504.41,
  "text": "Рассказываешь всё."
 },
 {
  "i": 182,
  "start": 504.93,
  "end": 507.03,
  "text": "Про цифры, про метро, про Лёху."
 },
 {
  "i": 183,
  "start": 507.61,
  "end": 508.69,
  "text": "Дедушка не смеётся."
 },
 {
  "i": 184,
  "start": 508.69,
  "end": 511.39,
  "text": "Он долго смотрит на тебя, а потом спрашивает."
 },
 {
  "i": 185,
  "start": 511.77,
  "end": 512.63,
  "text": "А мой какой?"
 },
 {
  "i": 186,
  "start": 513.39,
  "end": 514.63,
  "text": "Зелёный, врёшь ты."
 },
 {
  "i": 187,
  "start": 515.21,
  "end": 516.27,
  "text": "Дедушка улыбается."
 },
 {
  "i": 188,
  "start": 516.47,
  "end": 516.97,
  "text": "Врёшь."
 },
 {
  "i": 189,
  "start": 517.13,
  "end": 517.83,
  "text": "Ну и правильно."
 },
 {
  "i": 190,
  "start": 518.07,
  "end": 519.33,
  "text": "Я и не хочу знать."
 },
 {
  "i": 191,
  "start": 520.21,
  "end": 521.95,
  "text": "И дедушка в этом не одинок."
 },
 {
  "i": 192,
  "start": 522.23,
  "end": 524.77,
  "text": "Есть тяжёлая наследственная болезнь."
 },
 {
  "i": 193,
  "start": 525.05,
  "end": 526.51,
  "text": "Болезнь Гентингтона."
 },
 {
  "i": 194,
  "start": 527.19,
  "end": 531.81,
  "text": "Если она была у одного из родителей, шанс получить её пятьдесят на пятьдесят."
 },
 {
  "i": 195,
  "start": 532.31,
  "end": 536.95,
  "text": "И существует генетический тест, который точно скажет, есть ли у тебя этот ген."
 },
 {
  "i": 196,
  "start": 536.95,
  "end": 543.71,
  "text": "Так вот, по некоторым оценкам, до девяносто процентов людей из группы риска этот тест так и не делают."
 },
 {
  "i": 197,
  "start": 544.23,
  "end": 546.05,
  "text": "Они предпочитают не знать."
 },
 {
  "i": 198,
  "start": 547.23,
  "end": 550.45,
  "text": "Ты Лёху за шиворот к врачу не притащишь, говорит дедушка."
 },
 {
  "i": 199,
  "start": 550.97,
  "end": 552.71,
  "text": "Ты ему цифры свои не показывай."
 },
 {
  "i": 200,
  "start": 553.15,
  "end": 554.79,
  "text": "Ты ему скажи, что тебе страшно."
 },
 {
  "i": 201,
  "start": 554.99,
  "end": 555.87,
  "text": "Правду скажи."
 },
 {
  "i": 202,
  "start": 555.87,
  "end": 556.75,
  "text": "Только свою."
 },
 {
  "i": 203,
  "start": 558.29,
  "end": 561.75,
  "text": "Вечером ты приходишь на тренировку Лёхи и смотришь с трибуны."
 },
 {
  "i": 204,
  "start": 561.89,
  "end": 562.67,
  "text": "И замечаешь."
 },
 {
  "i": 205,
  "start": 562.85,
  "end": 568.23,
  "text": "После рывка Лёха вдруг останавливается, садится прямо на газон и держится за голову."
 },
 {
  "i": 206,
  "start": 568.35,
  "end": 570.33,
  "text": "Через минуту встаёт и машет рукой."
 },
 {
  "i": 207,
  "start": 570.47,
  "end": 571.23,
  "text": "Нормально всё."
 },
 {
  "i": 208,
  "start": 571.81,
  "end": 574.11,
  "text": "В глазах потемнело, отмахивается он потом."
 },
 {
  "i": 209,
  "start": 574.37,
  "end": 574.85,
  "text": "Бывает."
 },
 {
  "i": 210,
  "start": 575.17,
  "end": 577.31,
  "text": "Уже пару раз так было, когда сильно бегу."
 },
 {
  "i": 211,
  "start": 577.87,
  "end": 579.33,
  "text": "И между делом добавляет."
 },
 {
  "i": 212,
  "start": 579.63,
  "end": 581.39,
  "text": "У меня, кстати, дядька такой же был."
 },
 {
  "i": 213,
  "start": 581.67,
  "end": 582.97,
  "text": "Здоровый мужик -спортсмен."
 },
 {
  "i": 214,
  "start": 583.21,
  "end": 584.05,
  "text": "Умер в 32."
 },
 {
  "i": 215,
  "start": 584.41,
  "end": 585.09,
  "text": "Сердце, говорят."
 },
 {
  "i": 216,
  "start": 585.87,
  "end": 587.27,
  "text": "У тебя холодеет спина."
 },
 {
  "i": 217,
  "start": 587.67,
  "end": 590.29,
  "text": "Потому что ты уже перечитал всё, что смог найти."
 },
 {
  "i": 218,
  "start": 590.81,
  "end": 591.83,
  "text": "Есть болезнь."
 },
 {
  "i": 219,
  "start": 592.25,
  "end": 594.19,
  "text": "Гипертрофическая кардиомеопатия."
 },
 {
  "i": 220,
  "start": 594.19,
  "end": 596.73,
  "text": "Стенка сердца становится слишком толстой."
 },
 {
  "i": 221,
  "start": 597.09,
  "end": 599.57,
  "text": "Человек может годами ни о чём не подозревать."
 },
 {
  "i": 222,
  "start": 599.67,
  "end": 602.75,
  "text": "Пока на сильной нагрузке сердце вдруг не собьётся с ритма."
 },
 {
  "i": 223,
  "start": 603.33,
  "end": 606.03,
  "text": "Ею болеет примерно один человек из 500."
 },
 {
  "i": 224,
  "start": 606.41,
  "end": 610.13,
  "text": "И это одна из главных причин внезапной смерти молодых спортсменов."
 },
 {
  "i": 225,
  "start": 610.41,
  "end": 612.51,
  "text": "Примерно треть всех таких случаев."
 },
 {
  "i": 226,
  "start": 612.79,
  "end": 613.83,
  "text": "Но вот что важно."
 },
 {
  "i": 227,
  "start": 614.17,
  "end": 618.63,
  "text": "Почти в девяти случаях из десяти перед бедой были тревожные знаки."
 },
 {
  "i": 228,
  "start": 618.73,
  "end": 621.25,
  "text": "Обмороки или потемнение в глазах на нагрузке."
 },
 {
  "i": 229,
  "start": 621.25,
  "end": 623.05,
  "text": "Изменения на кардиограмме."
 },
 {
  "i": 230,
  "start": 623.27,
  "end": 626.07,
  "text": "Или родственники, которые рано умерли от сердца."
 },
 {
  "i": 231,
  "start": 627.01,
  "end": 628.25,
  "text": "Ты считаешь дни."
 },
 {
  "i": 232,
  "start": 628.45,
  "end": 629.53,
  "text": "И до тебя доходит."
 },
 {
  "i": 233,
  "start": 630.07,
  "end": 633.81,
  "text": "Финал турнира ровно в тот день, когда таймер Лёхи дойдёт до нуля."
 },
 {
  "i": 234,
  "start": 634.45,
  "end": 636.81,
  "text": "Ты уговариваешь Лёху сходить к кардиологу."
 },
 {
  "i": 235,
  "start": 636.97,
  "end": 637.73,
  "text": "Он смеётся."
 },
 {
  "i": 236,
  "start": 638.11,
  "end": 639.71,
  "text": "Тёма, я здоров как бык."
 },
 {
  "i": 237,
  "start": 640.13,
  "end": 641.09,
  "text": "Ты настаиваешь."
 },
 {
  "i": 238,
  "start": 641.35,
  "end": 642.03,
  "text": "Он злится."
 },
 {
  "i": 239,
  "start": 642.37,
  "end": 645.21,
  "text": "Ты то мотоцикл у меня забираешь, то по врачам гонишь."
 },
 {
  "i": 240,
  "start": 645.43,
  "end": 646.03,
  "text": "Ты мне кто?"
 },
 {
  "i": 241,
  "start": 646.27,
  "end": 646.61,
  "text": "Мама?"
 },
 {
  "i": 242,
  "start": 647.11,
  "end": 648.47,
  "text": "Он хлопает дверью."
 },
 {
  "i": 243,
  "start": 648.63,
  "end": 650.69,
  "text": "И три дня не отвечает на сообщение."
 },
 {
  "i": 244,
  "start": 651.25,
  "end": 653.47,
  "text": "Тогда ты вспоминаешь слова дедушки."
 },
 {
  "i": 245,
  "start": 653.83,
  "end": 656.33,
  "text": "Приходишь к Лёхе вечером и говоришь."
 },
 {
  "i": 246,
  "start": 656.55,
  "end": 658.61,
  "text": "Лёх, я не знаю, как объяснить."
 },
 {
  "i": 247,
  "start": 658.95,
  "end": 660.41,
  "text": "Мне просто страшно."
 },
 {
  "i": 248,
  "start": 660.55,
  "end": 662.05,
  "text": "По -настоящему страшно."
 },
 {
  "i": 249,
  "start": 662.59,
  "end": 663.93,
  "text": "Сходи, ради меня."
 },
 {
  "i": 250,
  "start": 664.17,
  "end": 664.77,
  "text": "Один раз."
 },
 {
  "i": 251,
  "start": 665.79,
  "end": 667.35,
  "text": "Лёха долго смотрит на тебя."
 },
 {
  "i": 252,
  "start": 667.77,
  "end": 668.63,
  "text": "Потом сдыхает."
 },
 {
  "i": 253,
  "start": 669.33,
  "end": 670.45,
  "text": "Ладно, схожу."
 },
 {
  "i": 254,
  "start": 670.67,
  "end": 671.77,
  "text": "Но после финала."
 },
 {
  "i": 255,
  "start": 672.25,
  "end": 673.61,
  "text": "Мы год к нему шли, Тём."
 },
 {
  "i": 256,
  "start": 673.95,
  "end": 675.33,
  "text": "Я команду не брошу."
 },
 {
  "i": 257,
  "start": 675.93,
  "end": 677.25,
  "text": "Ты смотришь на таймер."
 },
 {
  "i": 258,
  "start": 677.49,
  "end": 678.63,
  "text": "Он не меняется."
 },
 {
  "i": 259,
  "start": 678.81,
  "end": 679.31,
  "text": "Конечно."
 },
 {
  "i": 260,
  "start": 679.85,
  "end": 681.69,
  "text": "Обещание – это ещё не поступок."
 },
 {
  "i": 261,
  "start": 682.85,
  "end": 683.79,
  "text": "Восемь дней."
 },
 {
  "i": 262,
  "start": 685.01,
  "end": 686.39,
  "text": "Ночью ты не можешь уснуть."
 },
 {
  "i": 263,
  "start": 686.63,
  "end": 687.91,
  "text": "Лежишь и считаешь."
 },
 {
  "i": 264,
  "start": 688.53,
  "end": 689.37,
  "text": "Восемь дней."
 },
 {
  "i": 265,
  "start": 689.83,
  "end": 691.37,
  "text": "Сто девяносто два часа."
 },
 {
  "i": 266,
  "start": 691.63,
  "end": 692.93,
  "text": "А что, если ты ошибся?"
 },
 {
  "i": 267,
  "start": 693.07,
  "end": 695.17,
  "text": "Что, если дело вовсе не в сердце?"
 },
 {
  "i": 268,
  "start": 695.39,
  "end": 700.45,
  "text": "Что, если ты будешь стоять у поля с дефибриллятором, а беда придёт совсем с другой стороны?"
 },
 {
  "i": 269,
  "start": 700.91,
  "end": 704.79,
  "text": "Ты встаёшь, идёшь в ванную и снова смотришь в зеркало."
 },
 {
  "i": 270,
  "start": 705.05,
  "end": 706.43,
  "text": "Над тобой пусто."
 },
 {
  "i": 271,
  "start": 706.43,
  "end": 709.41,
  "text": "И впервые тебе становится по -настоящему страшно."
 },
 {
  "i": 272,
  "start": 709.47,
  "end": 710.95,
  "text": "Не за Лёху, а за себя."
 },
 {
  "i": 273,
  "start": 711.53,
  "end": 715.67,
  "text": "Ведь ты ходишь мимо сотен таймеров каждый день, а свой не знаешь."
 },
 {
  "i": 274,
  "start": 716.21,
  "end": 717.15,
  "text": "Может он зелёный?"
 },
 {
  "i": 275,
  "start": 717.49,
  "end": 718.01,
  "text": "А может?"
 },
 {
  "i": 276,
  "start": 718.89,
  "end": 721.51,
  "text": "Ты выключаешь свет и возвращаешься в кровать."
 },
 {
  "i": 277,
  "start": 721.91,
  "end": 723.63,
  "text": "А на следующий день звонит мама."
 },
 {
  "i": 278,
  "start": 724.09,
  "end": 724.69,
  "text": "Приезжай."
 },
 {
  "i": 279,
  "start": 724.81,
  "end": 726.29,
  "text": "Папа месяц без сигарет."
 },
 {
  "i": 280,
  "start": 726.49,
  "end": 727.17,
  "text": "Торт купили."
 },
 {
  "i": 281,
  "start": 727.73,
  "end": 729.05,
  "text": "Он срывался два раза."
 },
 {
  "i": 282,
  "start": 729.39,
  "end": 730.99,
  "text": "Мама прятала от него зажигалки."
 },
 {
  "i": 283,
  "start": 731.27,
  "end": 732.13,
  "text": "Но он держится."
 },
 {
  "i": 284,
  "start": 732.59,
  "end": 740.75,
  "text": "Ты приезжаешь, обнимаешь папу и видишь, как над его головой цифры дёргаются, мигают и становятся зелёными."
 },
 {
  "i": 285,
  "start": 741.87,
  "end": 742.73,
  "text": "16 лет."
 },
 {
  "i": 286,
  "start": 743.13,
  "end": 743.93,
  "text": "Значит работает."
 },
 {
  "i": 287,
  "start": 744.31,
  "end": 745.39,
  "text": "Значит можно."
 },
 {
  "i": 288,
  "start": 746.07,
  "end": 750.13,
  "text": "Мама на кухне режет торт и не понимает, почему ты так долго обнимаешь папу."
 },
 {
  "i": 289,
  "start": 750.27,
  "end": 751.01,
  "text": "А папа ворчит."
 },
 {
  "i": 290,
  "start": 751.37,
  "end": 753.37,
  "text": "Тортом заедать – это ж тоже вредно."
 },
 {
  "i": 291,
  "start": 753.61,
  "end": 754.43,
  "text": "Но улыбается."
 },
 {
  "i": 292,
  "start": 755.23,
  "end": 757.45,
  "text": "Остаётся одно – быть рядом."
 },
 {
  "i": 293,
  "start": 757.69,
  "end": 760.01,
  "text": "Ты снова идёшь на курсы первой помощи."
 },
 {
  "i": 294,
  "start": 760.17,
  "end": 761.71,
  "text": "На этот раз по -настоящему."
 },
 {
  "i": 295,
  "start": 761.79,
  "end": 763.57,
  "text": "С манекеном и инструктором."
 },
 {
  "i": 296,
  "start": 763.57,
  "end": 767.47,
  "text": "Ты выясняешь, что на стадионе есть автоматический дефибриллятор."
 },
 {
  "i": 297,
  "start": 767.69,
  "end": 770.33,
  "text": "Прибор, который сам голосом подсказывает, что делать."
 },
 {
  "i": 298,
  "start": 770.85,
  "end": 772.17,
  "text": "Находишь, где он висит."
 },
 {
  "i": 299,
  "start": 772.33,
  "end": 774.97,
  "text": "Проходишь от поля до него и засекаешь время."
 },
 {
  "i": 300,
  "start": 775.37,
  "end": 776.23,
  "text": "Сорок секунд."
 },
 {
  "i": 301,
  "start": 777.09,
  "end": 781.17,
  "text": "Вечером накануне финала вы с Лёхой сидите на крыше гаражей, как в школе."
 },
 {
  "i": 302,
  "start": 781.31,
  "end": 782.71,
  "text": "Пьёте чай из термоса."
 },
 {
  "i": 303,
  "start": 783.11,
  "end": 784.63,
  "text": "Лёха болтает о будущем."
 },
 {
  "i": 304,
  "start": 784.77,
  "end": 786.63,
  "text": "Что после финала возьмёт отпуск."
 },
 {
  "i": 305,
  "start": 786.85,
  "end": 788.05,
  "text": "Что хочет на Байкал."
 },
 {
  "i": 306,
  "start": 788.39,
  "end": 791.45,
  "text": "Что пора бы уже научиться готовить что -то, кроме пельменей."
 },
 {
  "i": 307,
  "start": 791.45,
  "end": 794.09,
  "text": "А ты смотришь на цифры над его головой."
 },
 {
  "i": 308,
  "start": 794.59,
  "end": 795.25,
  "text": "Ноль дней."
 },
 {
  "i": 309,
  "start": 795.71,
  "end": 796.53,
  "text": "Двадцать часов."
 },
 {
  "i": 310,
  "start": 796.99,
  "end": 798.93,
  "text": "Ты открываешь рот, чтобы рассказать всё."
 },
 {
  "i": 311,
  "start": 799.23,
  "end": 801.57,
  "text": "Про таймеры, про метро, про сорок дней."
 },
 {
  "i": 312,
  "start": 801.95,
  "end": 802.77,
  "text": "И закрываешь."
 },
 {
  "i": 313,
  "start": 803.19,
  "end": 804.37,
  "text": "Он не поверит."
 },
 {
  "i": 314,
  "start": 804.53,
  "end": 808.11,
  "text": "А если поверит, завтра он выйдет на поле, думая только об этом."
 },
 {
  "i": 315,
  "start": 809.09,
  "end": 812.61,
  "text": "«Тём, ты чего такой ?» – спрашивает Лёха, будто прощаешься."
 },
 {
  "i": 316,
  "start": 813.03,
  "end": 815.95,
  "text": "– Да так, – говоришь ты, – просто рад, что мы друзья."
 },
 {
  "i": 317,
  "start": 816.59,
  "end": 817.57,
  "text": "Лёха фыркает."
 },
 {
  "i": 318,
  "start": 817.85,
  "end": 819.73,
  "text": "– Ну всё, совсем расклеился."
 },
 {
  "i": 319,
  "start": 819.73,
  "end": 821.65,
  "text": "И толкает тебя плечом."
 },
 {
  "i": 320,
  "start": 821.89,
  "end": 822.71,
  "text": "День финала."
 },
 {
  "i": 321,
  "start": 822.87,
  "end": 824.05,
  "text": "Трибуны полные."
 },
 {
  "i": 322,
  "start": 824.17,
  "end": 825.79,
  "text": "Над Лёхой красный таймер."
 },
 {
  "i": 323,
  "start": 826.11,
  "end": 826.73,
  "text": "Ноль дней."
 },
 {
  "i": 324,
  "start": 827.07,
  "end": 827.77,
  "text": "Один час."
 },
 {
  "i": 325,
  "start": 828.11,
  "end": 828.69,
  "text": "Сорок минут."
 },
 {
  "i": 326,
  "start": 829.63,
  "end": 831.01,
  "text": "Лёха играет как бог."
 },
 {
  "i": 327,
  "start": 831.31,
  "end": 832.97,
  "text": "Забивает на тридцатой минуте."
 },
 {
  "i": 328,
  "start": 833.09,
  "end": 834.11,
  "text": "Трибуны орут."
 },
 {
  "i": 329,
  "start": 834.47,
  "end": 835.75,
  "text": "А ты не смотришь на мяч."
 },
 {
  "i": 330,
  "start": 835.91,
  "end": 837.41,
  "text": "Ты смотришь только на цифры."
 },
 {
  "i": 331,
  "start": 838.09,
  "end": 839.63,
  "text": "Семьдесят восьмая минута."
 },
 {
  "i": 332,
  "start": 839.75,
  "end": 843.35,
  "text": "Лёха рвётся в атаку, обходит защитника и падает."
 },
 {
  "i": 333,
  "start": 843.51,
  "end": 845.49,
  "text": "Просто падает лицом в газон."
 },
 {
  "i": 334,
  "start": 845.69,
  "end": 846.73,
  "text": "Без столкновения."
 },
 {
  "i": 335,
  "start": 846.91,
  "end": 847.49,
  "text": "Без удара."
 },
 {
  "i": 336,
  "start": 847.93,
  "end": 848.99,
  "text": "А ты уже бежишь."
 },
 {
  "i": 337,
  "start": 848.99,
  "end": 850.53,
  "text": "Ты знаешь, куда бежать."
 },
 {
  "i": 338,
  "start": 851.05,
  "end": 851.79,
  "text": "Не дышит."
 },
 {
  "i": 339,
  "start": 852.11,
  "end": 852.53,
  "text": "Скорую."
 },
 {
  "i": 340,
  "start": 852.69,
  "end": 853.39,
  "text": "Сто двенадцать."
 },
 {
  "i": 341,
  "start": 853.49,
  "end": 854.51,
  "text": "Кричишь ты судье."
 },
 {
  "i": 342,
  "start": 854.97,
  "end": 856.59,
  "text": "Дефибриллятору входа в раздевалку."
 },
 {
  "i": 343,
  "start": 856.69,
  "end": 857.53,
  "text": "Кричишь тренеру."
 },
 {
  "i": 344,
  "start": 857.91,
  "end": 858.87,
  "text": "Ладони на грудь."
 },
 {
  "i": 345,
  "start": 858.93,
  "end": 859.27,
  "text": "Раз."
 },
 {
  "i": 346,
  "start": 859.57,
  "end": 860.13,
  "text": "Два."
 },
 {
  "i": 347,
  "start": 860.31,
  "end": 860.81,
  "text": "Три."
 },
 {
  "i": 348,
  "start": 860.99,
  "end": 861.49,
  "text": "Четыре."
 },
 {
  "i": 349,
  "start": 861.89,
  "end": 863.19,
  "text": "Краем глаза видишь таймер."
 },
 {
  "i": 350,
  "start": 863.37,
  "end": 864.11,
  "text": "Он мигает."
 },
 {
  "i": 351,
  "start": 864.39,
  "end": 865.17,
  "text": "Сорок секунд."
 },
 {
  "i": 352,
  "start": 865.41,
  "end": 866.27,
  "text": "Минута двадцать."
 },
 {
  "i": 353,
  "start": 866.51,
  "end": 867.45,
  "text": "Снова тридцать."
 },
 {
  "i": 354,
  "start": 867.93,
  "end": 869.53,
  "text": "Тренер приносит дефибриллятор."
 },
 {
  "i": 355,
  "start": 869.69,
  "end": 873.17,
  "text": "Ты открываешь крышку, и прибор спокойным голосом говорит, что делать."
 },
 {
  "i": 356,
  "start": 873.47,
  "end": 874.71,
  "text": "Наклеить электроды."
 },
 {
  "i": 357,
  "start": 874.89,
  "end": 876.29,
  "text": "Не касаться пострадавшего."
 },
 {
  "i": 358,
  "start": 876.55,
  "end": 877.05,
  "text": "Разряд."
 },
 {
  "i": 359,
  "start": 877.65,
  "end": 878.79,
  "text": "Леха вздрагивает."
 },
 {
  "i": 360,
  "start": 879.07,
  "end": 880.59,
  "text": "Ты снова давишь на грудь."
 },
 {
  "i": 361,
  "start": 880.67,
  "end": 881.07,
  "text": "Раз."
 },
 {
  "i": 362,
  "start": 881.53,
  "end": 882.21,
  "text": "Два."
 },
 {
  "i": 363,
  "start": 882.45,
  "end": 883.13,
  "text": "Три."
 },
 {
  "i": 364,
  "start": 883.27,
  "end": 884.67,
  "text": "И вдруг вдох."
 },
 {
  "i": 365,
  "start": 885.03,
  "end": 887.19,
  "text": "Хриплый, рваный, но вдох."
 },
 {
  "i": 366,
  "start": 887.65,
  "end": 888.73,
  "text": "Ты поднимаешь глаза."
 },
 {
  "i": 367,
  "start": 889.09,
  "end": 891.05,
  "text": "Таймер над Лехой больше не мигает."
 },
 {
  "i": 368,
  "start": 891.25,
  "end": 893.73,
  "text": "Цифры бегут вверх, как счетчик на заправке."
 },
 {
  "i": 369,
  "start": 893.95,
  "end": 895.43,
  "text": "И становятся зелеными."
 },
 {
  "i": 370,
  "start": 896.19,
  "end": 897.47,
  "text": "Пятьдесят один год."
 },
 {
  "i": 371,
  "start": 898.11,
  "end": 900.93,
  "text": "Через несколько минут на поле выбегают врачи скорой."
 },
 {
  "i": 372,
  "start": 901.35,
  "end": 905.15,
  "text": "Они забирают Леху, а один из них, уходя, хлопает тебя по плечу."
 },
 {
  "i": 373,
  "start": 905.15,
  "end": 907.11,
  "text": "Вы все сделали правильно."
 },
 {
  "i": 374,
  "start": 907.31,
  "end": 908.57,
  "text": "Без вас бы не довезли."
 },
 {
  "i": 375,
  "start": 909.21,
  "end": 910.45,
  "text": "Трибуны стоят."
 },
 {
  "i": 376,
  "start": 910.61,
  "end": 913.67,
  "text": "Тишина такая, что слышно, как хлопают на ветру флаги."
 },
 {
  "i": 377,
  "start": 913.93,
  "end": 915.75,
  "text": "А потом кто -то начинает аплодировать."
 },
 {
  "i": 378,
  "start": 916.03,
  "end": 917.91,
  "text": "И весь стадион следом."
 },
 {
  "i": 379,
  "start": 918.79,
  "end": 920.73,
  "text": "В больнице врачи подтверждают."
 },
 {
  "i": 380,
  "start": 921.25,
  "end": 923.13,
  "text": "Гипертрофическая кардиомеопатия."
 },
 {
  "i": 381,
  "start": 923.69,
  "end": 925.77,
  "text": "Лехе ставит под кожу маленький прибор."
 },
 {
  "i": 382,
  "start": 926.33,
  "end": 927.77,
  "text": "Имплантируемый дефибриллятор."
 },
 {
  "i": 383,
  "start": 928.21,
  "end": 931.93,
  "text": "Если сердце снова собьется с ритма, он сам его перезапустит."
 },
 {
  "i": 384,
  "start": 932.37,
  "end": 937.75,
  "text": "А когда можно будет вернуться к большому футболу, и можно ли вообще, решать будут врачи."
 },
 {
  "i": 385,
  "start": 938.55,
  "end": 941.33,
  "text": "Леха лежит в палате, бледный, и смотрит на тебя."
 },
 {
  "i": 386,
  "start": 941.99,
  "end": 943.37,
  "text": "Тём, ты знал?"
 },
 {
  "i": 387,
  "start": 943.99,
  "end": 945.37,
  "text": "Ты пожимаешь плечами."
 },
 {
  "i": 388,
  "start": 945.73,
  "end": 947.67,
  "text": "Скажем так, было предчувствие."
 },
 {
  "i": 389,
  "start": 948.33,
  "end": 950.43,
  "text": "Леха молчит, а потом улыбается."
 },
 {
  "i": 390,
  "start": 951.07,
  "end": 952.47,
  "text": "Спасибо, что был занудый."
 },
 {
  "i": 391,
  "start": 953.43,
  "end": 955.11,
  "text": "Вечером ты снова стоишь у зеркала."
 },
 {
  "i": 392,
  "start": 955.31,
  "end": 957.55,
  "text": "Над твоей головой по -прежнему пусто."
 },
 {
  "i": 393,
  "start": 958.13,
  "end": 960.83,
  "text": "Наверное, ты так никогда и не узнаешь свой таймер."
 },
 {
  "i": 394,
  "start": 961.81,
  "end": 966.09,
  "text": "И в этом ты ничем не отличаешься от всех остальных людей на Земле."
 },
 {
  "i": 395,
  "start": 966.81,
  "end": 971.87,
  "text": "Кстати, наш мозг и без всякой суперсилы отлично умеет не замечать собственный таймер."
 },
 {
  "i": 396,
  "start": 972.39,
  "end": 975.21,
  "text": "Учёные называют это оптимистическим искажением."
 },
 {
  "i": 397,
  "start": 975.89,
  "end": 983.37,
  "text": "Примерно у 80 % людей мозг завышает шансы на хорошее в собственной жизни и занижает шансы на плохое."
 },
 {
  "i": 398,
  "start": 983.91,
  "end": 987.51,
  "text": "Болезнь, авария – это всё случается с кем -то другим."
 },
 {
  "i": 399,
  "start": 987.51,
  "end": 995.25,
  "text": "Это помогает нам вставать по утрам и строить планы, но из -за этого же мы откладываем кардиолога и бросаем курить потом."
 },
 {
  "i": 400,
  "start": 996.41,
  "end": 999.09,
  "text": "А вот ещё одно открытие, которое тебя поразило."
 },
 {
  "i": 401,
  "start": 999.55,
  "end": 1004.89,
  "text": "Учёные свели вместе почти 150 исследований больше 300 тысяч человек."
 },
 {
  "i": 402,
  "start": 1005.25,
  "end": 1012.97,
  "text": "И выяснили, у людей с крепкими связями, семьёй, друзьями шансы выжить за время наблюдения были примерно в полтора раза выше."
 },
 {
  "i": 403,
  "start": 1013.63,
  "end": 1016.09,
  "text": "По силе влияния это сравнимо с курением."
 },
 {
  "i": 404,
  "start": 1016.97,
  "end": 1019.01,
  "text": "И есть ещё одна история."
 },
 {
  "i": 405,
  "start": 1019.83,
  "end": 1025.53,
  "text": "Австралийская медсестра Бронни Уэр много лет ухаживала за людьми, которым оставались считанные недели."
 },
 {
  "i": 406,
  "start": 1025.83,
  "end": 1031.59,
  "text": "Она записывала, о чём они жалеют, и почти никто не жалел, что мало работал или мало заработал."
 },
 {
  "i": 407,
  "start": 1031.93,
  "end": 1040.49,
  "text": "Жалели о другом, что жили не своей жизнью, а той, которую от них ждали, что слишком много работали, что потеряли связь с друзьями."
 },
 {
  "i": 408,
  "start": 1040.81,
  "end": 1045.53,
  "text": "У этих людей таймеры были красными, но поняли они это слишком поздно."
 },
 {
  "i": 409,
  "start": 1045.53,
  "end": 1049.67,
  "text": "Получается, таймеры не висят над нами по отдельности, они связаны."
 },
 {
  "i": 410,
  "start": 1049.97,
  "end": 1052.11,
  "text": "Папа бросил курить ради твоей свадьбы."
 },
 {
  "i": 411,
  "start": 1052.35,
  "end": 1056.33,
  "text": "Лёха жив, потому что друг оказался рядом и не побоялся быть занудой."
 },
 {
  "i": 412,
  "start": 1056.71,
  "end": 1060.11,
  "text": "Мужчина из метро жив, потому что незнакомый парень не прошёл мимо."
 },
 {
  "i": 413,
  "start": 1060.47,
  "end": 1065.49,
  "text": "Ты не видишь свой таймер, но ты можешь влиять на чужие, а они на твой."
 },
 {
  "i": 414,
  "start": 1065.89,
  "end": 1067.79,
  "text": "В субботу ты снова едешь на дачу."
 },
 {
  "i": 415,
  "start": 1067.95,
  "end": 1069.69,
  "text": "Дедушка встречает тебя у калитки."
 },
 {
  "i": 416,
  "start": 1069.85,
  "end": 1071.95,
  "text": "Над ним всё тот же красный таймер."
 },
 {
  "i": 417,
  "start": 1072.09,
  "end": 1073.49,
  "text": "Год и шесть месяцев."
 },
 {
  "i": 418,
  "start": 1073.91,
  "end": 1075.03,
  "text": "Вы сажаете яблоню."
 },
 {
  "i": 419,
  "start": 1075.03,
  "end": 1078.35,
  "text": "Посадим, говорит дедушка, а собирать будешь ты."
 },
 {
  "i": 420,
  "start": 1078.49,
  "end": 1083.59,
  "text": "И ты впервые за этот месяц смотришь не на цифры над его головой, а на него самого."
 },
 {
  "i": 421,
  "start": 1084.45,
  "end": 1086.51,
  "text": "Ну как, Лёха, спрашивает дедушка."
 },
 {
  "i": 422,
  "start": 1087.25,
  "end": 1090.75,
  "text": "Живой, говоришь ты, ругается, что футбол пока запретили."
 },
 {
  "i": 423,
  "start": 1091.41,
  "end": 1092.39,
  "text": "Дедушка смеётся."
 },
 {
  "i": 424,
  "start": 1092.87,
  "end": 1096.35,
  "text": "Раз ругается, значит живой, а потом добавляет."
 },
 {
  "i": 425,
  "start": 1096.71,
  "end": 1098.79,
  "text": "Ты, Тёма, от цифры своей не считай."
 },
 {
  "i": 426,
  "start": 1099.09,
  "end": 1100.69,
  "text": "Ни мои, ни чужие."
 },
 {
  "i": 427,
  "start": 1101.19,
  "end": 1104.67,
  "text": "Считай, сколько раз за день ты по -настоящему с кем -то поговорил."
 },
 {
  "i": 428,
  "start": 1104.67,
  "end": 1106.85,
  "text": "Вот это твой таймер."
 },
 {
  "i": 429,
  "start": 1107.61,
  "end": 1108.81,
  "text": "А теперь вопрос тебе."
 },
 {
  "i": 430,
  "start": 1109.43,
  "end": 1113.53,
  "text": "Если бы ты мог увидеть свой собственный таймер, ты бы посмотрел?"
 },
 {
  "i": 431,
  "start": 1113.91,
  "end": 1116.37,
  "text": "Или как дедушка предпочел бы не знать?"
 },
 {
  "i": 432,
  "start": 1116.99,
  "end": 1118.31,
  "text": "Напиши в комментариях."
 },
 {
  "i": 433,
  "start": 1118.85,
  "end": 1119.57,
  "text": "И ещё одно."
 },
 {
  "i": 434,
  "start": 1120.11,
  "end": 1123.63,
  "text": "Если ты никогда не учился первой помощи, найди курс."
 },
 {
  "i": 435,
  "start": 1123.79,
  "end": 1125.03,
  "text": "Это всего пара часов."
 },
 {
  "i": 436,
  "start": 1125.57,
  "end": 1129.49,
  "text": "А когда -нибудь они могут превратиться в чьи -то лишние годы."
 },
 {
  "i": 437,
  "start": 1129.63,
  "end": 1138.83,
  "text": "И если у тебя когда -нибудь темнело в глазах или ты потерял сознание во время нагрузки, а кто -то в семье рано умирать сердце, не отмахивайся как Лёха."
 },
 {
  "i": 438,
  "start": 1139.13,
  "end": 1140.51,
  "text": "Сходи к кардиологу."
 },
 {
  "i": 439,
  "start": 1140.69,
  "end": 1142.89,
  "text": "Кардиограмма занимает несколько минут."
 },
 {
  "i": 440,
  "start": 1143.63,
  "end": 1148.05,
  "text": "Если тебе понравился этот выпуск, подпишись на канал и нажми на колокольчик."
 },
 {
  "i": 441,
  "start": 1148.59,
  "end": 1152.23,
  "text": "Таймер твоего свободного времени это почти не уменьшит."
 },
 {
  "i": 442,
  "start": 1152.75,
  "end": 1156.15,
  "text": "А мы скоро встретимся в новом выпуске «Что если»."
 }
]